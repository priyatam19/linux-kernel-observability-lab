diff --git a/kernel/sys_s2_encrypt.c b/kernel/sys_s2_encrypt.c
new file mode 100644
--- /dev/null
+++ b/kernel/sys_s2_encrypt.c
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Lab syscall maintained by Priyatam Annambhotla. Not cryptographic encryption. */
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/syscalls.h>
+#include <linux/uaccess.h>
+
+#define BUF_SIZE 256
+
+SYSCALL_DEFINE2(s2_encrypt, const char __user *, user_str, int, key)
+{
+	char buf[BUF_SIZE];
+	long len;
+	int i;
+
+	if (key < 1 || key > 5)
+		return -EINVAL;
+	len = strncpy_from_user(buf, user_str, sizeof(buf));
+	if (len < 0)
+		return len;
+	if (len >= sizeof(buf))
+		return -ENAMETOOLONG;
+	for (i = 0; i < len; i++)
+		buf[i] = (unsigned char)buf[i] + key;
+	pr_info("s2_encrypt: %s\n", buf);
+	return 0;
+}
